{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-calculator.local/schemas/engines.schema.json",
  "title": "Engines Catalog Schema",
  "description": "Валидация каталога инференс-движков",
  "type": "object",
  "required": ["metadata", "engines"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["version", "collected_at"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d{4}\\.\\d{2}$"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "engines": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Engine"
      },
      "minItems": 4,
      "description": "Минимум 4 инференс-движка"
    }
  },
  "definitions": {
    "Engine": {
      "type": "object",
      "required": ["id", "name", "gpu_only"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "description": "Имя для UI (может отличаться от id)"
        },
        "gpu_only": {
          "type": "boolean",
          "description": "Только GPU режим (false допуска offload в RAM)"
        },
        "default_util_target": {
          "type": ["number", "null"],
          "nullable": true,
          "minimum": 0.5,
          "maximum": 1.0,
          "description": "Целевая утилизация GPU по умолчанию (vLLM 0.90, llama.cpp 0.95)"
        },
        "overhead_gb": {
          "type": ["number", "null"],
          "nullable": true,
          "minimum": 0,
          "description": "Оверхэд в ГБ (CUDA context + буферы на GPU)"
        },
        "supports_tp": {
          "type": "boolean",
          "default": false,
          "description": "Поддержка Tensor Parallelism"
        },
        "kv_bytes_per_elem": {
          "type": ["number", "string"],
          "enum": [1, 2],
          "default": 2,
          "description": "Размер KV элемента: 1 для FP8, 2 для FP16/BF16"
        },
        "cuda_graphs": {
          "type": ["boolean", "null"],
          "nullable": true,
          "default": false,
          "description": "Поддержка CUDA графов"
        }
      },
      "additionalProperties": false
    }
  }
}
